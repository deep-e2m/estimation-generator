# =============================================================================
# Quote Generation Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed
# For Docker: docker compose will use this file automatically
#
# IMPORTANT: Never commit .env files with real secrets to version control!
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="Quote Generation Assistant"
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# =============================================================================
# Docker Service Ports
# =============================================================================
# These ports are exposed on the host machine
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# For Docker: Uses internal Docker networking (db:5432)
# For local development: Use localhost:5432
POSTGRES_DB=quote_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full database URL (auto-constructed in docker-compose.yml)
# For local development outside Docker, use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quote_assistant

# =============================================================================
# Redis Configuration
# =============================================================================
# For Docker: Uses internal Docker networking (redis:6379)
# For local development: Use localhost:6379
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT Authentication
# =============================================================================
# IMPORTANT: Change this in production! Must be at least 32 characters.
SECRET_KEY=dev-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Storage Configuration
# =============================================================================
# Storage provider: 'database' (MVP) or 's3' (Production)
STORAGE_PROVIDER=database

# =============================================================================
# AWS S3 Configuration (only if STORAGE_PROVIDER=s3)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# =============================================================================
# Frontend Configuration
# =============================================================================
# API URL for the frontend to connect to backend
# For Docker development: Leave empty (uses proxy)
# For Docker production: Set to your API domain
VITE_API_URL=

# =============================================================================
# CORS Configuration
# =============================================================================
# Additional CORS origins (comma-separated) - useful for custom domains
# Default origins are already configured in the backend for localhost and Docker
# CORS_ORIGINS=["http://localhost:3000","http://your-custom-domain.com"]

# =============================================================================
# File Upload Limits
# =============================================================================
# MAX_FILE_SIZE_MB=10

# =============================================================================
# Rate Limiting
# =============================================================================
# RATE_LIMIT_REQUESTS_PER_MINUTE=100
# RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# =============================================================================
# OpenRouter Configuration (LLM API)
# =============================================================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_APP_NAME="Estimate AI"
OPENROUTER_HTTP_REFERER=http://localhost:3000

# =============================================================================
# LLM Settings
# =============================================================================
# Temperature controls randomness (0.0 = deterministic, 2.0 = creative)
LLM_DEFAULT_TEMPERATURE=0.3
# Maximum tokens for LLM responses
LLM_DEFAULT_MAX_TOKENS=4096
# Request timeout in seconds
LLM_REQUEST_TIMEOUT=120

# =============================================================================
# RAG (Retrieval-Augmented Generation) Settings
# =============================================================================
# Number of similar documents to retrieve for context
RAG_TOP_K_RESULTS=5
# Minimum similarity score for retrieval (0.0-1.0)
RAG_SIMILARITY_THRESHOLD=0.7
# Maximum character length for RAG context
RAG_MAX_CONTEXT_LENGTH=8000
# Embedding dimensions (1536 for OpenAI text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Knowledge Base Settings
# =============================================================================
# Chunk size for document embedding
KNOWLEDGE_CHUNK_SIZE=512
# Overlap between chunks
KNOWLEDGE_CHUNK_OVERLAP=50

# =============================================================================
# URL Scraping (Reference URLs for Estimation)
# =============================================================================
# When enabled, URLs in description/instructions/docs are scraped and added to the brief.
# Default true so URLs in PDFs and description are used.
# Set ENABLE_URL_SCRAPING=false to disable (backend starts in ~15s without Playwright install).
# ENABLE_URL_SCRAPING=true
# MAX_REFERENCE_URLS=5
# URL_SCRAPE_TIMEOUT_SEC=25
# URL_REFERENCE_CONTEXT_MAX_CHARS=12000
# Allowed schemes: default is https only. For dev with localhost use ["https","http"]
# ALLOWED_URL_SCHEMES=["https"]
#
# Full-site crawl (discover + scrape all pages from one URL)
# SITE_CRAWL_ENABLED=true
# MAX_SITE_PAGES=25
# SITE_CRAWL_DEPTH=2
# SITE_CRAWL_TIMEOUT_SEC=90
#
# Reference site video (Playwright recording; full-site preview can record a .webm)
# REFERENCE_VIDEO_STORAGE_PATH=/tmp/estimate-ai-videos
# REFERENCE_VIDEO_SECONDS_PER_PAGE=3
